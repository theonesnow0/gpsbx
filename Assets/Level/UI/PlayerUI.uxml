<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Level/UI/DefaultUSS.uss?fileID=7433441132597879392&amp;guid=fa33cd7b905613a4d82e216122775c43&amp;type=3#DefaultUSS"/>
    <ui:VisualElement name="FpsCounter" style="flex-grow: 1; flex-direction: row; position: absolute; height: 42px; width: 161px;">
        <ui:Label text="fps:" name="Label" style="-unity-text-align: upper-left; font-size: 20px;"/>
        <ui:Label text="Label" name="Value" data-source="project://database/Assets/Level/Prefabs/FpsMetric.asset?fileID=11400000&amp;guid=b0f47fd26f5bd2842b0847ddd3b60dab&amp;type=2#FpsMetric" data-source-path="framesPerSecond" style="height: 37px; width: 142px; font-size: 20px; -unity-font-style: bold-and-italic; -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(0, 0, 0); color: rgb(255, 255, 255); position: relative;">
            <Bindings>
                <ui:DataBinding property="text" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
    </ui:VisualElement>
</ui:UXML>
