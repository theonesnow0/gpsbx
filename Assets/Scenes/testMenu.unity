  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412\u044B \u0431\u044B\u043B\u0438 \u0437\u0430\u0431\u0430\u043D\u0435\u043D\u044B
    \u0432 \u043D\u0430\u0448\u0435\u0439 \u0438\u0433\u0440\u0435.\n\u041C\u043E\u0436\u0435\u0442
    \u0431\u044B\u0442\u044C \u043C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u0447\u0438\u043D,
    \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0432\u0430\u0441 \u043C\u043E\u0433\u043B\u0438
    \u0437\u0430\u0431\u0430\u043D\u0438\u0442\u044C.\n\u041F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435
    \u043E \u043D\u0430\u0448\u0438\u0445 \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0445
    \u0438\u0433\u0440\u044B \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
    \u043D\u0430\u0439\u0442\u0438\n\u0432 \u043D\u0430\u0448\u0435\u043C \u0434\u0438\u0441\u043A\u043E\u0440\u0434
    \u0441\u0435\u0440\u0432\u0435\u0440\u0435."
