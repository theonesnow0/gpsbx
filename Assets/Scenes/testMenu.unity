--- !u!114 &136422771
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 136422769}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=35>                        \u041E\u0431 \u0418\u0433\u0440\u0435</size>\n\u042D\u0442\u0430
    \u0438\u0433\u0440\u0430 \u0431\u044B\u043B\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u0430
    \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u0438\u0433\u0440\u044B KoGaMa,
    \u0437\u0430 \u0447\u0442\u043E \u0431\u043E\u043B\u0448\u043E\u0435 \u0441\u043F\u0430\u0441\u0438\u0431\u043E,
    \u0432\u0435\u0434\u044C \u0435\u0441\u043B\u0438 \u0431\u044B \u044F \u043D\u0435
    \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0441\u044F \u0441 \u043D\u0435\u0439,
    \u0442\u043E, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u044D\u0442\u0430
    \u0438\u0433\u0440\u0430 \u0431\u044B \u0438 \u043D\u0435 \u0432\u044B\u0448\u043B\u0430.
    \u0422\u0430\u043A \u0436\u0435 \u0432 KoGaMa \u0435\u0441\u0442\u044C \u043E\u0447\u0435\u043D\u044C
    \u043F\u043E\u043B\u0435\u0437\u043D\u0430\u044F \u0444\u0443\u043D\u043A\u0446\u0438\u044F
    \u0431\u0435\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0442\u043E\u0436\u0435
    \u043D\u0438\u0447\u0435\u0433\u043E \u0431\u044B \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C,
    \u0430 \u0438\u043C\u0435\u043D\u043D\u043E \u043A\u043E\u043C\u043C\u0430\u043D\u0434\u0430
    \u0447\u0430\u0442\u0430 /export. \u0421 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
    \u044D\u0442\u043E\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u044F \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043B
    \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u0432\u0441\u0435 - \u0441\u043A\u0438\u043D\u044B,
    \u0437\u0434\u0430\u043D\u0438\u044F, \u043C\u043E\u0434\u0435\u043B\u0438, \u0437\u0430
    \u0447\u0442\u043E \u043A\u043E\u043D\u0435\u0447\u043D\u043E \u0436\u0435 \u0435\u0449\u0435
    \u0440\u0430\u0437 \u0441\u043F\u0430\u0441\u0438\u0431\u043E \u0438\u0433\u0440\u0435
    KoGaMa. \u0422\u0435\u043A\u0441\u0442\u0443\u0440\u044B \u0442\u0430\u043A \u0436\u0435
    \u0432\u0437\u044F\u0442\u044B \u0438\u0437 \u0438\u0433\u0440\u044B KoGaMa.
    \u041F\u043E\u0447\u0442\u0438 \u0432\u0441\u044F \u044D\u0442\u0430 \u0438\u0433\u0440\u0430
    - \u044D\u0442\u043E \u043E\u0441\u043D\u043E\u0432\u0430 KoGaMa. \u042D\u0442\u0443
    \u0438\u0433\u0440\u0443 \u044F \u0441\u0434\u0435\u043B\u0430\u043B \u043B\u0438\u0448\u044C
    \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0445\u043E\u0442\u0435\u043B
    \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0434\u043B\u044F \u0441\u0435\u0431\u044F
    \u0447\u0442\u043E \u0442\u043E \u043D\u043E\u0432\u043E\u0435, \u0438 \u0432\u0438\u0434\u0438\u043C\u043E,
    \u0443 \u043C\u0435\u043D\u044F \u044D\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.
    \u0425\u043E\u0442\u044F \u0432 \u0441\u0430\u043C\u043E\u043C \u043D\u0430\u0447\u0430\u043B\u0435
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u044D\u0442\u043E\u0439
    \u0438\u0433\u0440\u044B \u044F \u043D\u0435 \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043B
    \u0435\u0435 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0438\u043B\u044C\u043D\u043E
    \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0442\u044C. \u0414\u0430 \u0438 \u0432
    \u0446\u0435\u043B\u043E\u043C \u044F \u043D\u0430\u0447\u0430\u043B \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
    \u044D\u0442\u043E\u0439 \u0438\u0433\u0440\u043E\u0439 \u043F\u043E\u0441\u043B\u0435
    \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043A\u0443\u0440\u0441\u0430 \u0432
    \u043A\u043E\u043B\u043B\u0435\u0434\u0436\u0435, \u0430 \u0443\u0447\u0443\u0441\u044C
    \u044F \u043D\u0430 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442\u0430.
    \u0414\u0430\u0436\u0435 \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430
    \u0442\u043E, \u0447\u0442\u043E \u0432\u0440\u043E\u0434\u0435 \u0431\u044B
    \u0443\u0447\u0438\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043D\u0430\u0441 \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u043B\u0438
    \u043D\u0430\u0447\u0430\u0442\u044C \u0432\u043E \u0432\u0442\u043E\u0440\u043E\u043C
    \u043A\u0443\u0440\u0441\u0435, \u0443 \u043D\u0430\u0441 \u044D\u0442\u043E
    \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E,
    \u0445\u043E\u0442\u044F, \u044D\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0437\u0432\u0430\u0442\u044C
    \u043D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435\u043C, \u0432\u0435\u0434\u044C
    \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u0447\u0442\u0438 \u043A\u0430\u043A
    \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u0437\u0430\u043D\u044F\u0442\u0438\u0435, \u043A\u0442\u043E \u0442\u043E \u0431\u0430\u043B\u0431\u0435\u0441\u043D\u0438\u0447\u0430\u043B,
    \u0430 \u044F \u0440\u0435\u0430\u043B\u044C\u043D\u043E \u0441\u0442\u0430\u043B
    \u043B\u0443\u0447\u0448\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C
    \u044E\u043D\u0438\u0442\u0438. \u041D\u0443 \u0432 \u043E\u0431\u0449\u0435\u043C,
    \u0447\u0442\u043E \u044F \u0445\u043E\u0447\u0443 \u0441\u043A\u0430\u0437\u0430\u0442\u044C
    - \u0438\u0433\u0440\u0430 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \u043D\u0430\u0448\u0435\u0439
    \u043B\u044E\u0431\u0438\u043C\u043E\u0439 \u0438\u0433\u0440\u0435 KoGaMa, \u0438
    \u044F \u043E\u0447\u0435\u043D\u044C \u0440\u0430\u0434 \u0447\u0442\u043E \u044D\u0442\u0430
    \u0438\u0433\u0440\u0430 \u0441\u043C\u043E\u0433\u043B\u0430 \u0432\u044B\u0439\u0442\u0438
    \u0432 \u0431\u0435\u0442\u0430 \u0442\u0435\u0441\u0442. \u0425\u043E\u0447\u0443
    \u0435\u0449\u0435 \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u0430\u043C
    \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435 \u0441\u043F\u0430\u0441\u0438\u0431\u043E
    \u0437\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0443 \u044D\u0442\u043E\u0433\u043E
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u0430\u043A\u0442\u0438\u0432, \u044F \u044D\u0442\u043E \u043E\u0447\u0435\u043D\u044C
    \u0446\u0435\u043D\u044E. \u0422\u0430\u043A \u0436\u0435 \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439\u0442\u0435
    \u0437\u0430\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0442\u044C \u0432 KoGaMa,
    \u0432\u0435\u0434\u044C \u0442\u0430\u043C \u0443\u0436\u0435 \u0432\u044B\u0448\u043B\u043E
    \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u0430 \u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u0443\u0435\u043C\u044B\u0435
    \u043F\u0443\u0448\u043A\u0438!\n\u0412\u0441\u0435 \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B
    \u0438 \u043C\u043E\u0434\u0435\u043B\u0438 \u0438\u0437 KoGaMa \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0442
    Multiverse Aps, \u044F \u043D\u0435 \u0432\u044B\u0434\u0430\u044E \u0435\u0435
    \u043A\u043E\u043D\u0442\u0435\u043D\u0442 \u0437\u0430 \u0441\u0432\u043E\u0439,
    \u044F \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C \u0434\u0435\u043B\u0430\u044E
    \u0444\u0430\u043D \u0438\u0433\u0440\u0443 :3"
